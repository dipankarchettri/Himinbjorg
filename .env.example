# Copy to .env (or ~/.config/himinbjorg/env) and fill in.
# Never commit real keys: .env is gitignored.

# Provider keys, read by the Bifrost container (infra/data/config.json).
# All optional: with none set, everything runs on local Ollama models
# (cloud tiers fail over to the local model). With no Ollama, set the
# three model tiers below to cloud models; see "Cloud only".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google AI Studio key
GEMINI_API_KEY=
# One key for Claude, GPT, DeepSeek, Qwen...
OPENROUTER_API_KEY=
# Free tier: fast, but about 8K tokens/minute
GROQ_API_KEY=
# A vLLM server on this host (optional). Bifrost reaches it at
# host.docker.internal:8012 (infra/data/config.json), so vLLM must listen on
# the Docker bridge, e.g. --host 172.17.0.1 --port 8012
VLLM_API_KEY=

# Tavily web search (optional; never used in confidential mode)
TAVILY_API_KEY=

# Bifrost gateway (infra/docker-compose.yml maps it to host port 8099)
BIFROST_BASE_URL=http://localhost:8099
# Unlocks the gateway's /api surface: per-request logs and session cost.
# Must match BIFROST_SETUP_TOKEN in infra/docker-compose.yml.
BIFROST_SETUP_TOKEN=bifrost-local-setup-token

# Per-user virtual keys, issued by Bifrost governance (infra/data/config.json)
BIFROST_VK_DEMO=sk-bf-demo-user-key
BIFROST_VK_CONFIDENTIAL=sk-bf-confidential-key

# Native Ollama on the host, as seen from this machine
OLLAMA_URL=http://localhost:11434

# Models. The local tier must return structured tool calls: the
# qwen2.5-coder family does not (see docs/VERIFIED.md), the instruct models do.
AGENT_MODEL_LOCAL_SMALL=ollama/qwen3:1.7b
AGENT_MODEL_LOCAL_CODE=ollama/qwen2.5:32b-instruct
# Cloud tiers. The defaults are openai/gpt-4o-mini and
# anthropic/claude-sonnet-5-5; without those keys, set them to models you
# have, or every call first fails over to the local model.
# Verified with a Gemini key (tool calls work through Bifrost, real prices):
# AGENT_MODEL_CHEAP=gemini/gemini-3.1-flash-lite
# AGENT_MODEL_CAPABLE=gemini/gemini-3.5-flash
# Or OpenAI / Anthropic:
# AGENT_MODEL_CHEAP=openai/gpt-4o-mini
# AGENT_MODEL_CAPABLE=anthropic/claude-sonnet-5-5

# Cloud only (no Ollama, no GPU): the local tier is used for simple steps
# and has no fallback, so point it at a cloud model as well, e.g.
# AGENT_MODEL_LOCAL_CODE=gemini/gemini-3.1-flash-lite
# AGENT_MODEL_CHEAP=gemini/gemini-3.1-flash-lite
# AGENT_MODEL_CAPABLE=gemini/gemini-3.5-flash
# Confidential mode needs a local model and is unavailable without one.

# Tuning (optional)
# AGENT_PRUNE_STEP=4          # default; keeps the prompt prefix stable for prompt caching
# AGENT_CONTEXT_TOKENS=28000  # keep below the local model's context window
# AGENT_CLOUD_CONTEXT_TOKENS=64000  # the same, for cloud models
# AGENT_REASONING_EFFORT=           # low|medium|high for cloud models; unset keeps each model's own
# AGENT_PRUNE_MODE=turns      # or budget: keep context verbatim (cheaper only with prompt caching); auto: budget on cloud, turns on local
# AGENT_SUBAGENT=0            # 1: offer investigate, a read-only helper with its own context
# AGENT_PLAN=0                # 1: offer todo, a checklist kept in view on changes

# Approved commands run in a Landlock sandbox on Linux: auto, required or off
# AGENT_SANDBOX=auto
# Let sandboxed commands open TCP connections (pip install, npm install)
# AGENT_SANDBOX_NETWORK=0
